generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  displayName  String         @map("display_name")
  role         String
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  events       Event[]
  registrations Registration[]
  teachingAssignments InstructorAssignment[] @relation("AssignedInstructor")
  recordedAttendance Attendance[]
  @@map("users")
}

model Event {
  id                String         @id @default(uuid()) @db.Uuid
  organizerId       String         @map("organizer_id") @db.Uuid
  organizer         User           @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  title             String
  startsAt          DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime       @map("ends_at") @db.Timestamptz(6)
  location          String
  capacity          Int
  version           Int            @default(0)
  registrationDeadline DateTime?   @map("registration_deadline") @db.Timestamptz(6)
  description       String?
  publicationStatus String         @map("publication_status")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  registrations     Registration[]
  instructorAssignments InstructorAssignment[]
  @@index([publicationStatus, startsAt, id])
  @@index([organizerId, createdAt, id])
  @@map("events")
}

model InstructorAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  instructor   User      @relation("AssignedInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  @@index([instructorId, endedAt, eventId], map: "instructor_assignments_instructor_ended_event_idx")
  @@map("instructor_assignments")
}

model Registration {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  status        String
  registeredAt  DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant   User     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  attendance    Attendance?
  @@index([eventId, status, registeredAt, id])
  @@index([participantId, registeredAt, id])
  @@map("registrations")
}

model Attendance {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @unique @map("registration_id") @db.Uuid
  checkedInAt    DateTime     @map("checked_in_at") @db.Timestamptz(6)
  checkedInBy    String       @map("checked_in_by") @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  recorder       User         @relation(fields: [checkedInBy], references: [id], onDelete: Restrict)
  @@map("attendance")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_sessions_expire")
  @@map("sessions")
}
