# Server runtime settings; production values are supplied by the deployment.
NODE_ENV=development
PORT=3000
# Local Compose databases only. Never use these values for cloud deployments.
DATABASE_URL=postgresql://regmeup_app:regmeup-local-only@127.0.0.1:55432/regmeup_dev
TEST_DATABASE_URL=postgresql://regmeup_app:regmeup-local-only@127.0.0.1:55432/regmeup_test
# Use a unique random secret of at least 32 characters, stored securely.
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Exact browser origin (scheme and host, without path or trailing slash).
APP_ORIGIN=http://localhost:5173
# Optional: set to 1 only in production behind one trusted HTTPS proxy.
# TRUST_PROXY_HOPS=1
# Optional absolute directory containing the built SPA (set in the Docker image).
# FRONTEND_DIR=/app/client/dist
# Local/test synthetic fixtures only; do not use in production.
# ALLOW_SYNTHETIC_SEED=1
# SEED_PASSWORD=replace_with_a_synthetic_test_only_password
# Explicit one-off demo provisioning for a dedicated course demo database only.
# Supply passwords securely at execution time; never store real values here.
# ALLOW_DEMO_PROVISION=1
# DEMO_EXPECTED_DATABASE=replace_with_dedicated_demo_database_name
# DEMO_PARTICIPANT_PASSWORD=
# DEMO_ORGANIZER_PASSWORD=
# Vite development proxy (in client/.env.local, not the server runtime):
# REGMEUP_API_PROXY_TARGET=http://localhost:3000
