{
  "name": "@regmeup/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate --config prisma.config.ts && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "tsx scripts/check-migration-history.ts && prisma migrate deploy --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": { "@prisma/adapter-pg": "7.10.1", "@prisma/client": "7.10.1", "argon2": "0.45.2", "connect-pg-simple": "10.0.0", "dotenv": "17.2.3", "express": "5.3.0", "express-session": "1.19.0", "pg": "8.23.1" },
  "devDependencies": { "@types/connect-pg-simple": "7.0.3", "@types/express": "5.0.6", "@types/express-session": "1.19.0", "@types/pg": "8.23.1", "prisma": "7.10.1", "tsx": "4.23.15", "vitest": "5.1.0" }
}
